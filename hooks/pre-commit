#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""gpot-loc 提交前钩子：一条命令搞定（规则合规 + 单测）。

2026-10-13 改版：原来钩子要跑两条命令（rule_check.py + verify.py --only unit），
现在 `tools/verify.py` 内部先跑规则检查再跑测试，钩子只剩**一条**。

为什么钩子不跑全套（2026-10-04 老板定的纪律，不动摇）：
  * 全套 ≈55s，要起服务 + 真浏览器，提交时跑太重；
  * `ST_NO_LOCAL_LLM=1` 必须注入，禁止真跑本地 Ollama 占显存；
  * 全套请在提交前**手动**跑一次 `python tools/verify.py`（它会自动判档）。

判档由 `tools/tier.py` 按改动路径自动做（T1 文档 / T2 UI / T3 core），
钩子固定用 `--only unit`：规则 + 单测 ≈18s，不起服务、不碰浏览器。

触发条件：暂存区里有 `src/` 或 `tools/` 下的改动（只改文档不触发，不浪费时间）。

绕过（调试用，别成习惯）：`git commit --no-verify` 或 `SKIP_PRECOMMIT=1 git commit`

安装：`python hooks/install_hooks.py`（设 core.hooksPath=hooks，随仓库走）
"""

import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
TRIGGER_PREFIXES = ('src/', 'tools/')
TRIGGER_FILES = ('hooks/pre-commit', 'hooks/install_hooks.py', 'AGENTS.md')
SKIP_ENV = 'SKIP_PRECOMMIT'

# 解释器候选（本仓库验证脚本在托管 venv 里装齐依赖）
_PY_CANDS = [
    r'C:\Users\Administrator\.workbuddy\binaries\python\envs\default\Scripts\python.exe',
    sys.executable,
    'python',
]


def _pick_python():
    for c in _PY_CANDS:
        if not c:
            continue
        if os.path.sep in c and not os.path.isfile(c):
            continue
        try:
            rc = subprocess.call([c, '-c', 'import sys'],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            continue
        if rc == 0:
            return c
    return sys.executable


def _staged_files():
    """暂存区文件（相对根，正斜杠）。

    ⚠️ 必须 `-c core.quotepath=false`：否则 git 把中文路径转义成八进制，
    导致 startswith('src/') 判定失败、钩子静默不触发（2026-10-04 实测踩过）。
    """
    try:
        out = subprocess.check_output(
            ['git', '-c', 'core.quotepath=false', 'diff', '--cached',
             '--name-only', '--diff-filter=ACMR'],
            cwd=ROOT, stderr=subprocess.DEVNULL)
    except Exception:
        return []
    return [l.strip().replace('\\', '/')
            for l in out.decode('utf-8', 'replace').splitlines() if l.strip()]


def _needs_check(files):
    for f in files:
        if f in TRIGGER_FILES:
            return True
        if f.startswith(TRIGGER_PREFIXES):
            return True
    return False


def _run(py, args, env):
    p = subprocess.run([py] + args, cwd=ROOT, env=env,
                       capture_output=True, text=True, encoding='utf-8', errors='replace')
    return p.returncode, (p.stdout or '') + (p.stderr or '')


def main():
    if os.environ.get(SKIP_ENV):
        print('[pre-commit] %s 已设置，跳过。' % SKIP_ENV)
        return 0

    files = _staged_files()
    if not _needs_check(files):
        print('[pre-commit] 本次改动不触及 src/ 或 tools/，跳过。')
        return 0

    py = _pick_python()
    env = dict(os.environ)
    env['PYTHONPATH'] = os.path.join(ROOT, 'src')
    env['ST_NO_LOCAL_LLM'] = '1'      # 纪律：日常回归禁止真跑本地 LLM

    print('[pre-commit] 规则合规 + 单测 (tools/verify.py --only unit) ...')
    rc, out = _run(py, ['tools/verify.py', '--only', 'unit'], env)
    tail = [l for l in out.splitlines() if l.strip()][-10:]
    print('\n'.join(tail))
    if rc != 0:
        print('\n[pre-commit] 未通过，提交被拒。')
        print('  · 规则类（R1 判据 / R2 反向验红 / R5 UI 签核）→ 修法见 '
              'I:\\AIcoding\\gpot-loc\\AGENTS.md 铁律 7 / 8 / R5')
        print('  · 单测类 → 看上面 FAIL 段')
        print('  · 确属误报可 --no-verify，但请先确认不是真违规。')
        return 1

    print('\n[pre-commit] 通过。提醒：提交前手动跑一次自动判档全套 '
          '`python tools/verify.py`（≈55s）。')
    return 0


if __name__ == '__main__':
    sys.exit(main())
